/*
  Arquivos web embutidos no executável (compilado para web.res pelo build.bat).

  O nome do recurso é o caminho na URL em maiúsculas, com tudo que não for
  letra ou dígito trocado por "_":
    https://app.localhost/index.html    -> INDEX_HTML
    https://app.localhost/img/logo.svg  -> IMG_LOGO_SVG

  Ao adicionar um arquivo na pasta web\, acrescente uma linha aqui.
*/

INDEX_HTML    RCDATA "web\\index.html"
STYLE_CSS     RCDATA "web\\style.css"
APP_JS        RCDATA "web\\app.js"
IMG_LOGO_SVG  RCDATA "web\\img\\logo.svg"
